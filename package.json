{
  "name": "zola.386-11ty-port",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "rm -rf _site && eleventy --config=eleventy.config.js && pagefind --site _site --glob \"**/*.html\"",
    "start": "eleventy --serve --config=eleventy.config.js --incremental"
  },
  "engines": {
    "node": ">=24.14.0",
    "npm": ">=11.9.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.5",
    "@11ty/eleventy-plugin-rss": "3.0.0",
    "luxon": "^3.5.0",
    "pagefind": "1.5.0"
  }
}
